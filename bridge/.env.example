# Bridge runtime
PORT=8787
BRIDGE_HOST=127.0.0.1
# Optional comma-separated non-loopback origins. All HTTP(S) loopback origins
# (localhost, *.localhost, 127.0.0.0/8, and ::1) are allowed automatically.
BRIDGE_CORS_ORIGINS=

# Provider credentials
OPENCODE_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_CN_API_KEY=

# Optional: require clients to authenticate to Bridge itself.
BRIDGE_API_KEY=
