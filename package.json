{
  "name": "deepseek-harness-on-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sandboxed self-modifying page agent runtime and Chrome MV3 extension",
  "scripts": {
    "build": "vite build --mode extension && node scripts/verify-extension-build.mjs",
    "build:standalone": "vite build --mode standalone",
    "build:fixtures": "vite build --config examples/vite.config.ts",
    "dev:fixtures": "vite --config examples/vite.config.ts",
    "serve": "node serve.mjs",
    "dev": "vite build --mode extension --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run build:standalone && npm run build:fixtures"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@deepseek-ai/cordis": "4.0.1",
    "@earendil-works/pi-ai": "0.84.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vicons/tabler": "^0.13.0",
    "ajv": "^8.20.0",
    "naive-ui": "^2.45.2",
    "openai": "^7.5.0",
    "vue": "^3.5.13",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "happy-dom": "^20.11.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
